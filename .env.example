PORT=6500
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_OMNI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_OMNI_API_TIMEOUT_MS=180000
GEMINI_OMNI_VIDEO_DEBUG=false
CIVITAI_API_KEY=
# xAI Grok Imagine image generation and edit API key.
X_API_KEY=your_xai_api_key_here
# Meta Muse remains catalog-disabled until response, pricing and qualification
# evidence passes. META_MUSE_API-KEY is accepted as a compatibility alias.
META_MUSE_API_KEY=
META_MUSE_API-KEY=
META_MUSE_BASE_URL=https://api.meta.ai/v1
META_MUSE_API_TIMEOUT_MS=120000
META_MUSE_DEBUG=false
MODEL_ARK_API-KEY=your_ark_api_key_here
# Optional aliases for deployments that cannot use hyphenated env names.
MODEL_ARK_API=
ARK_API_KEY=
MODEL_ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
MODEL_ARK_API_TIMEOUT_MS=180000
# Sanitized lifecycle diagnostics for every video provider. Logs submit, poll,
# download, provider codes and timings, but never credentials, raw prompts,
# reference URLs or Base64 media. Provider-specific flags remain aliases.
VIDEO_PROVIDER_DEBUG=false
GEMINI_VIDEO_DEBUG=false
MODEL_ARK_VIDEO_DEBUG=false
# Durable Video poster extraction. FFMPEG_PATH may be an absolute executable
# path when ffmpeg is not available through PATH.
FFMPEG_PATH=ffmpeg
VIDEO_POSTER_TIMEOUT_MS=30000
XAI_API_TIMEOUT_MS=120000
PROVIDER_CONFIG_PATH=server/config/providers.json
MAX_CONCURRENT_GENERATIONS=2
# Set to false to use the standard OpenAI image response without partial-image streaming.
# If omitted, streaming remains enabled for backward compatibility.
ENABLE_OPENAI_API_STREAMING=false
# Optional text-only Prompt Director. Disabled unless both this flag and a real
# OPENAI_API_KEY are present.
ENABLE_AI_PROMPT_REFINE=false
# Optional Cinematic Story Director. Qualification calls are not customer-paid
# until the canonical Credits text-operation contract is enabled.
ENABLE_CINEMATIC_STORY_ENHANCEMENT=false
ENABLE_CINEMATIC_STORY_PLAN=false
CINEMATIC_STORY_PLAN_MODEL=gpt-5.6-luna
CINEMATIC_STORY_PLAN_REASONING_EFFORT=low
CINEMATIC_STORY_PLAN_TIMEOUT_MS=60000
CINEMATIC_STORY_PLAN_MAX_OUTPUT_TOKENS=8000
ENABLE_CINEMATIC_WARDROBE_SUGGESTION=false
CINEMATIC_WARDROBE_SUGGESTION_MODEL=gpt-5-mini
CINEMATIC_WARDROBE_SUGGESTION_REASONING=low
CINEMATIC_WARDROBE_SUGGESTION_MAX_OUTPUT_TOKENS=1800
CINEMATIC_WARDROBE_SUGGESTION_TIMEOUT_MS=60000
CINEMATIC_STORY_ENHANCEMENT_MODEL=gpt-5.6-luna
CINEMATIC_STORY_ENHANCEMENT_REASONING_EFFORT=low
CINEMATIC_STORY_ENHANCEMENT_TIMEOUT_MS=45000
CINEMATIC_STORY_ENHANCEMENT_MAX_OUTPUT_TOKENS=2400
ATTRIBUTE_LOCALIZATION_ENABLED=true
ATTRIBUTE_LOCALIZATION_MODEL=gpt-5.6-luna
ATTRIBUTE_LOCALIZATION_TIMEOUT_MS=20000
ATTRIBUTE_LOCALIZATION_MAX_OUTPUT_TOKENS=600
PROMPT_REFINEMENT_MODEL=gpt-5.6-luna
PROMPT_REFINEMENT_REASONING_EFFORT=low
PROMPT_REFINEMENT_TIMEOUT_MS=30000
PROMPT_REFINEMENT_MAX_OUTPUT_TOKENS=1800
PROMPT_REFINEMENT_AUDIT_MAX_FILES=500
# Local tuning only. Raw before/after prompts are never logged in production.
LOG_AI_PROMPT_REFINE=false
ENABLED_CACHE_ATTRIBUTE_BUNDLE=false
REFRESH_CACHE_ATTRIBUTE_BUNDLE=true
ATTRIBUTE_CATALOG_RUNTIME_ENABLED=false

# Admin/Support exposure. Safe metadata reads and local Support Cases are on by
# default. Production-risk commands remain off until their documented staff
# authentication, PostgreSQL, approval and transactional prerequisites pass.
ADMIN_OPERATIONS_READ_ENABLED=true
ADMIN_PROVIDER_HEALTH_READ_ENABLED=true
ADMIN_CONTENT_READ_ENABLED=true
ADMIN_TRACE_READ_ENABLED=true
SUPPORT_CASES_ENABLED=true
ADMIN_RUNTIME_CONFIGURATION_ENABLED=true
ADMIN_RUNTIME_CONFIGURATION_PUBLISH_ENABLED=false
ADMIN_SCHEDULED_CONFIGURATION_PUBLISH_ENABLED=false
SUPPORT_GENERATION_COMMANDS_ENABLED=false
ADMIN_CONTENT_COMMANDS_ENABLED=false
ADMIN_RESTRICTED_MEDIA_REVEAL_ENABLED=false
ADMIN_FINANCIAL_COMMANDS_ENABLED=false
ADMIN_ASSET_RECONCILIATION_ENABLED=false
