    {
      "name": "04. Faceless Previs (Mask Transformation - JSON Response)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "console.log('Ensure x-input-sha256 header matches input image SHA-256 hex string.');"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-post-processing-token",
            "value": "{{internalToken}}",
            "type": "text"
          },
          {
            "key": "x-expected-faces",
            "value": "1",
            "type": "text"
          },
          {
            "key": "x-input-sha256",
            "value": "{{inputSha256}}",
            "description": "SHA-256 hash of raw input image bytes",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "image/png",
            "type": "text"
          }
        ],
        "body": {
          "mode": "file",
          "file": {
            "src": ""
          }
        },
        "url": {
          "raw": "{{baseUrl}}/v1/faceless-previs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "faceless-previs"
          ]
        },
        "description": "Submits raw image bytes and returns a JSON object containing output metadata, checksums, and Base64 encoded PNG bytes (bytesBase64)."
      },
      "response": []
    },
    {
      "name": "05. Face Landmarks (JSON Coordinate Extraction)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-post-processing-token",
            "value": "{{internalToken}}",
            "type": "text"
          },
          {
            "key": "x-expected-faces",
            "value": "1",
            "type": "text"
          },
          {
            "key": "x-input-sha256",
            "value": "{{inputSha256}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "image/png",
            "type": "text"
          }
        ],
        "body": {
          "mode": "file",
          "file": {
            "src": ""
          }
        },
        "url": {
          "raw": "{{baseUrl}}/v1/face-landmarks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "face-landmarks"
          ]
        },
        "description": "Detects face landmarks on raw image bytes and returns normalized coordinate JSON."
      },
      "response": []
    }
  ]
