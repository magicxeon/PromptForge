# Loopback-only local pilot. Production must remain disabled until 021 gates pass.
POST_PROCESSING_HOST=127.0.0.1
POST_PROCESSING_PORT=6501
POST_PROCESSING_PILOT_ENABLED=false
# Optional relative-to-service or absolute path to the checksum-pinned model.
# POST_PROCESSING_FACE_MODEL_PATH=models/face_landmarker.task
# Set only in a private deployment secret store for direct service startup.
# scripts/start-dev.mjs generates a fresh token when this is unset.
# POST_PROCESSING_INTERNAL_TOKEN=

# Configures the maximum characters per chunk for TTS stability
TTS_CHUNK_LENGTH=100

# Postman-only, isolated-dialogue POC. Start with scripts/start-dialogue-poc.bat.
POST_PROCESSING_DIALOGUE_POC_ENABLED=false
POST_PROCESSING_DIALOGUE_DATA_ROOT=D:/applications/momelo-post-processing/data/dialogue-poc
POST_PROCESSING_FFMPEG_PATH=ffmpeg
POST_PROCESSING_FFPROBE_PATH=ffprobe
POST_PROCESSING_OPENVOICE_CHECKPOINT=D:/development/temp/momelo-models/openvoice/checkpoints_v2/converter
POST_PROCESSING_THAI_MODEL_PATH=D:/applications/momelo-post-processing/models/thonburian-tts
# Downloaded model/cache artifacts belong outside the repository.
HF_HOME=D:/development/temp/momelo-models/huggingface
TORCH_HOME=D:/development/temp/momelo-models/torch
PIP_CACHE_DIR=D:/development/temp/momelo-models/pip-cache
